{
  "name": "station-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p typecheck \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "typecheck": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-pattern=dist",
    "lint:eslint": "eslint . --fix",
    "lint:stylelint": "stylelint \"src/**/*.{css,vue}\"",
    "lint": "run-s lint:*",
    "format": "prettier --write src/",
    "check": "run-s format lint typecheck"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.1.13",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "3.0.3",
    "reka-ui": "^2.9.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "4.1.13",
    "tw-animate-css": "^1.4.0",
    "vue": "3.5.21",
    "vue-router": "4.5.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.16",
    "@tsconfig/node22": "22.0.2",
    "@types/node": "24.5.2",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.6.0",
    "@vue/tsconfig": "0.8.1",
    "eslint": "9.35.0",
    "eslint-plugin-oxlint": "1.16.0",
    "eslint-plugin-vue": "10.4.0",
    "jiti": "2.5.1",
    "npm-run-all2": "8.0.4",
    "oxlint": "1.16.0",
    "postcss-html": "^2.0.0",
    "prettier": "3.6.2",
    "stylelint": "^17.14.1",
    "stylelint-declaration-strict-value": "^1.11.1",
    "typescript": "5.9.2",
    "vite": "npm:rolldown-vite@7.1.11",
    "vue-tsc": "3.0.7"
  }
}
