# The benchmark's environment.
#
# Short on purpose. There are some sixty-five settings, and all but a handful
# live in the database now — one row, edited from the Space's UI or with
# `syft-benchmark settings set`. A setting that can be written in two places is
# a setting that disagrees with itself on the day somebody edits the wrong one.
#
# What stays here is what cannot be anywhere else: the things read before the
# database can be read, the perimeter, and the key that opens the stored
# secrets. Everything below is one of those three.
#
# THE ENVIRONMENT IS THE LAYER UNDER THE STORE, not a seed. Anything else set
# here still works and goes on working — it is read-only config supplied by
# whoever deployed this service — but the row above it wins, and that is where
# a change is made:
#
#   the built-in defaults -> this file -> the installation's row
#       -> the Space's instrument -> the endpoint's probe

# --- The database -------------------------------------------------------------
#
# It holds the settings, so it cannot be one of them.
BENCH_DATABASE_URL=postgresql+psycopg://benchmark:benchmark@localhost:5442/benchmark

# For docker compose, not for the application: which host port its Postgres is
# published on. 5442 so as not to argue with the hub's 5432.
BENCH_DB_PORT=5442

# --- The master key for stored secrets ------------------------------------------
#
# The provider keys and the Space tokens are sealed with AES-256-GCM before they
# reach the database. Without this there is nowhere to put them: the service
# refuses to store a secret rather than writing it in the clear, because an
# installation with half its secrets encrypted and no record of which half is
# worse than one that said no.
#
# Generate one — never invent one. A key a person types is a password, and a
# password is not 256 bits of anything:
#
#   uv run syft-benchmark secrets keygen
#
# What this protects: dumps, backups, replicas, a stolen volume. What it does
# not: anyone who can already read this file or the process's memory. That is
# the ordinary bargain of keeping the key outside the data, and the step beyond
# it is an external KMS, not a cleverer arrangement of the same key.
BENCH_SECRET_KEY=

# Keys kept only so that rows sealed under them still open, by the fingerprint
# they are recorded under. Rotating: put the old key here, set the new one
# above, run `syft-benchmark secrets rotate`, then delete this line.
# BENCH_SECRET_KEYS_RETIRED={"0ff5887483ad":"the-old-key-base64"}

# --- The control API ------------------------------------------------------------
#
# Through it the Space's UI disposes of the benchmark: it creates targets,
# stores settings, launches a measurement and watches where it stands.
#
# Until a key is set, the API answers only on /health and tells everything else
# that "control is not configured". This is not over-caution: its one route
# raises work worth hours and worth external models' money, and a port open by
# default would mean that anyone who reached the network could spend someone
# else's budget. A Space with benchmarks_mode=off behaves exactly the same way.
#
# It is here rather than in the store because it guards the API through which
# the store is edited, and a lock whose key is kept inside it is not a lock.
BENCH_CONTROL_TOKEN=
BENCH_CONTROL_HOST=0.0.0.0
BENCH_CONTROL_PORT=8200

# The origins CORS is allowed for. Empty — there are no browser requests at all:
# the UI comes here from its own server, not from a page. Filling this in means
# opening the launch of measurements to any open tab.
# BENCH_CONTROL_ORIGINS=["http://localhost:5173"]

# --- The perimeter (invariant 2) ------------------------------------------------
#
# The one group here that is not bootstrap, and it is the most important.
#
# The questions are generated from private documents and often quote them almost
# verbatim. The ban on calls outside is implemented as a check rather than an
# agreement, and the check reads this list. If it were editable through the API,
# anyone holding the control key could point the benchmark at a host of their
# choosing and the corpus would leave. That is a decision for whoever has this
# host, not for whoever has a key — which is why it is in a file on it.
BENCH_ALLOW_EXTERNAL_MODELS=false
# BENCH_EXTERNAL_HOSTS=["openrouter.ai"]

# --- The Space registry file ----------------------------------------------------
#
# A seed for the targets table, for an installation configured without a UI. A
# path on this host, so it is read from this host.
# BENCH_SPACES_FILE=config/spaces.json

# --- Running in a container -----------------------------------------------------
#
# `docker compose --profile service up -d` raises the service beside its
# database; without the profile only the database comes up, which is the console
# flow. The compose file overrides the addresses whose right value inside a
# container differs from the right value on a host — the database and the model
# provider, because `localhost` in a container is the container.
#
# What compose cannot guess is which docker network the rig is on. A Space
# raised by its own compose file calls it `syft-space-network`; one raised as
# part of a larger rig gets that project's name. `docker network ls` says which.
# BENCH_SPACE_NETWORK=syft-space-network

# ================================================================================
# Everything else — the models, the judges, the arms, the thresholds, the shape
# of the dataset, the provider addresses and their keys — is configured where it
# is used, not here:
#
#   the Space's UI            per Space (the instrument) and per endpoint (the probe)
#   syft-benchmark settings   the installation's own defaults, under both
#   syft-benchmark secrets    the provider keys, sealed
#
# A key left in this file goes on working, and the service says so at startup
# and in `secrets list`, naming it. Nothing copies it into the sealed store by
# itself: that would leave the plaintext here regardless — the part that
# matters — while making "the keys are encrypted at rest" true of everything
# except the one nobody was told about.
#
# The OpenRouter key goes in like this:
#
#   uv run syft-benchmark settings set ollama_url https://openrouter.ai/api/v1
#   printf %s "sk-or-..." | uv run syft-benchmark secrets set llm_api_key
#
# — piped rather than passed as an argument, because an argument is in the shell
# history and in the process list of every user on the machine.
#
# `syft-benchmark settings show` says what this installation has overridden;
# GET /defaults says what an unset setting comes to.
# ================================================================================
