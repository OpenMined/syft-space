# The benchmark's environment.
#
# Only what cannot live in the database: what is read before the database can
# be read, the perimeter, and the key that opens the stored secrets. Every
# other setting lives in one database row, edited from the Space's UI or with
# `syft-benchmark settings set`.
#
# Anything else set here still works, but the stored row wins; see
# docs/01-setup.md.

# --- The database -------------------------------------------------------------
#
# It holds the settings, so it cannot be one of them.
BENCH_DATABASE_URL=postgresql+psycopg://benchmark:benchmark@localhost:5442/benchmark

# For docker compose, not for the application: which host port its Postgres is
# published on (127.0.0.1 only). 5442 keeps clear of another Postgres on 5432.
BENCH_DB_PORT=5442

# --- The master key for stored secrets ------------------------------------------
#
# Generate with `uv run syft-benchmark secrets keygen`; see docs/01-setup.md.
BENCH_SECRET_KEY=

# The previous key while rotating (`syft-benchmark secrets rotate`), by its
# fingerprint.
# BENCH_SECRET_KEYS_RETIRED={"0ff5887483ad":"the-old-key-base64"}

# --- The control API ------------------------------------------------------------
#
# The Space's UI drives the benchmark through it: targets, settings, launches,
# progress. Until a key is set, only /health answers; everything else says that
# control is not configured. Kept here because it guards the API that edits the
# stored settings.
BENCH_CONTROL_TOKEN=
BENCH_CONTROL_HOST=0.0.0.0
BENCH_CONTROL_PORT=8200

# The origins CORS is allowed for. Empty: no browser requests; the Space's
# backend proxies the API.
# BENCH_CONTROL_ORIGINS=["http://localhost:5173"]

# --- The perimeter (invariant 2) ------------------------------------------------
#
# The questions are generated from private documents and often quote them. A
# model call to a host outside the perimeter needs both the flag and the host in
# the list. Kept here so that a holder of the control key cannot widen it.
BENCH_ALLOW_EXTERNAL_MODELS=false
# BENCH_EXTERNAL_HOSTS=["openrouter.ai"]

# --- The Space registry file ----------------------------------------------------
#
# A seed for the targets table; see docs/01-setup.md, "The Space registry".
# BENCH_SPACES_FILE=config/spaces.json

# --- Running in a container -----------------------------------------------------
#
# The docker network the Space is on (`docker network ls`); see
# docs/control-api.md, "In a container".
# BENCH_SPACE_NETWORK=syft-space-network
