{
  "name": "benchmark-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p typecheck \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "typecheck": "vue-tsc --build",
    "lint": "oxlint . --fix -D correctness --ignore-pattern=dist",
    "format": "prettier --write src/",
    "check": "run-s format lint typecheck"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.1.13",
    "lucide-vue-next": "^1.0.0",
    "tailwindcss": "4.1.13",
    "vue": "3.5.21",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.2",
    "@types/node": "24.5.2",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/tsconfig": "0.8.1",
    "npm-run-all2": "8.0.4",
    "oxlint": "1.16.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vite": "npm:rolldown-vite@7.1.11",
    "vue-tsc": "3.0.7"
  }
}
