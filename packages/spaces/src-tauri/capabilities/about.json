{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "about",
  "description": "enables the permissions for the 'about' window",
  "windows": ["about"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "shell:allow-open",
    "log:default"
  ]
}
