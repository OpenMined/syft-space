# Syft Space Server Environment Configuration
# Copy this file to .env and modify as needed

# =============================================================================
# Server Configuration
# =============================================================================

# Port for the Syft Space server (default: 8080)
SYFT_PORT=8080

# Enable debug mode (default: false)
SYFT_DEBUG=false

# =============================================================================
# Database Configuration
# =============================================================================

# SQLite database path (default: /data/app.db in Docker, ~/.syft-space/app.db locally)
# SQLITE_DB_PATH=/data/app.db

# Reset database on startup - WARNING: destroys all data (default: false)
SY_T)RESET_DB=false

# =============================================================================
# Authentication
# =============================================================================

# Admin API key for protected endpoints
# If empty, no authentication is enforced (dev mode)
SYFT_ADMIN_API_KEY=

# =============================================================================
# External Services
# =============================================================================

# Accounting service URL
SYFT_DEFAULT_ACCOUNTING_URL=https://syftaccounting.centralus.cloudapp.azure.com/

# Marketplace service URL
SYFT_DEFAULT_MARKETPLACE_URL=https://syfthub.openmined.org

# Public URL for callbacks/webhooks (optional)
# SYFT_PUBLIC_URL=https://your-public-domain.com
