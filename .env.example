# SyftAI Server Environment Configuration
# Copy this file to .env and modify as needed

# =============================================================================
# Server Configuration
# =============================================================================

# Port for the SyftAI server (default: 8080)
SYFTAI_PORT=8080

# Enable debug mode (default: false)
DEBUG=false

# =============================================================================
# Database Configuration
# =============================================================================

# SQLite database path (default: /data/app.db in Docker, ~/.syai-space/app.db locally)
# SQLITE_DB_PATH=/data/app.db

# Reset database on startup - WARNING: destroys all data (default: false)
RESET_DB=false

# =============================================================================
# Authentication
# =============================================================================

# Admin API key for protected endpoints
# If empty, no authentication is enforced (dev mode)
ADMIN_API_KEY=

# =============================================================================
# Multi-tenancy
# =============================================================================

# Enable multi-tenancy support (default: false)
ENABLE_MULTI_TENANCY=false

# Default tenant name when multi-tenancy is disabled (default: root)
DEFAULT_TENANT_NAME=root

# =============================================================================
# External Services
# =============================================================================

# Accounting service URL
DEFAULT_ACCOUNTING_URL=https://syftaccounting.centralus.cloudapp.azure.com/

# Marketplace service URL
DEFAULT_MARKETPLACE_URL=https://syfthub.openmined.org

# Public URL for callbacks/webhooks (optional)
# PUBLIC_URL=https://your-public-domain.com

# =============================================================================
# Ngrok Configuration (optional - for exposing to internet)
# =============================================================================

# Enable ngrok tunneling (default: false)
USE_NGROK=false

# Ngrok authentication token (required if USE_NGROK=true)
NGROK_AUTH_TOKEN=
