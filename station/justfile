# Syft Station — dev workflow.
#
# ONE Helm chart (chart/) is the source of truth for every deployment. Dev is
# that same chart with values-dev.yaml (ephemeral ChromaDB, locally-built
# station image, *.localhost hosts). Two inner loops:
#
#   just cluster                  # k3d + shared deps (ChromaDB, docling) only
#   just dev admin=you@org.com    # station on the HOST with hot-reload
#                                 #   (spaces still provisioned into k3d)
#   just up  admin=you@org.com    # FULL in-cluster: station pod via Helm
#   just down                     # tear the cluster down
#
# `just dev` is the everyday loop — edit backend code, uvicorn reloads, no
# image rebuild. `just up` is the parity check (in-cluster DNS, RBAC, the real
# deployed pod). Station UI: http://station.localhost. The station is the
# PARENT of its spaces, so use `station.localhost` as the domain during setup
# and spaces resolve at <subdomain>.station.localhost via Traefik on :80
# (*.localhost → 127.0.0.1 in browsers — no DNS setup).

cluster_name := "syft-station"
namespace := "syft-spaces"
release := "syft-station"
chart := "chart"
dev_values := "chart/values-dev.yaml"
station_image := "syft-station:dev"

# List available recipes.
default:
    @just --list

# Check the required tools are installed and Docker is running.
bootstrap:
    #!/usr/bin/env bash
    set -euo pipefail
    for tool in k3d kubectl helm docker; do
        command -v "$tool" >/dev/null || { echo "missing: $tool"; exit 1; }
    done
    docker info >/dev/null 2>&1 || { echo "Docker daemon is not running"; exit 1; }
    echo "All tools present and Docker is running."

# Create the k3d cluster (if missing) and apply split-horizon DNS. Shared by
# `just cluster`, `just dev`, and `just up` — the one place the cluster is born.
[private]
ensure-cluster: bootstrap
    #!/usr/bin/env bash
    set -euo pipefail
    if k3d cluster list | grep -q "^{{cluster_name}} "; then
        echo "Cluster '{{cluster_name}}' already exists."
    else
        k3d cluster create {{cluster_name}} \
            --registry-create {{cluster_name}}-registry:0.0.0.0:5111 \
            -p "80:80@loadbalancer" -p "443:443@loadbalancer"
    fi
    just cluster-dns

# The base the host-run loop builds on: the chart with the station OFF, so
# `just dev` runs the station on the host and provisions spaces into k3d.

# Create the cluster and install the shared deps only (no station pod).
cluster: ensure-cluster
    #!/usr/bin/env bash
    set -euo pipefail
    helm upgrade --install {{release}} {{chart}} \
        -n {{namespace}} --create-namespace \
        -f {{dev_values}} --set station.enabled=false \
        --wait --timeout 300s
    echo "Shared deps are up. Run the station: just dev you@org.com"

# So space-to-space (and SyftHub-to-space) calls hit the same public URLs the
# browser uses. Without this, in-cluster lookups of the .localhost hostnames
# fail (they only resolve to 127.0.0.1 in host browsers). ClusterIP is
# re-derived live since it can change when the cluster is recreated.

# Resolve *.station.localhost to Traefik inside the cluster (split-horizon DNS).
cluster-dns:
    #!/usr/bin/env bash
    set -euo pipefail
    # k3s deploys Traefik asynchronously — on a fresh cluster its Service
    # appears some seconds after the API server is up.
    echo "Waiting for Traefik..."
    until kubectl -n kube-system get svc traefik >/dev/null 2>&1; do sleep 2; done
    traefik_ip=$(kubectl -n kube-system get svc traefik -o jsonpath='{.spec.clusterIP}')
    kubectl -n kube-system create configmap coredns-custom \
        --from-literal=station.server="station.localhost:53 {
        template IN A {
            answer \"{{{{ .Name }} 60 IN A ${traefik_ip}\"
        }
    }" --dry-run=client -o yaml | kubectl apply -f -
    kubectl -n kube-system rollout restart deploy/coredns
    kubectl -n kube-system rollout status deploy/coredns --timeout=60s
    echo "In-cluster DNS: *.station.localhost -> ${traefik_ip} (Traefik)"

# Provisions spaces into k3d over your kubeconfig. Pass your SyftHub email for
# the admin role; optionally point at a different SyftHub:
#   just dev you@org.com
#   just dev admin=you@org.com hub=http://host.k3d.internal:8080

# Everyday loop: run the station on the HOST with hot-reload (spaces -> k3d).
dev admin="" hub="": cluster
    #!/usr/bin/env bash
    set -euo pipefail
    # just binds `admin=x` positionally as the literal string — accept both
    # `just dev x` and `just dev admin=x` by stripping the prefixes.
    admin_email="{{admin}}"; admin_email="${admin_email#admin=}"
    hub_url="{{hub}}"; hub_url="${hub_url#hub=}"
    if [ -z "$admin_email" ]; then
        echo "WARNING: no admin email set — every sign-in gets the member role."
    fi
    export SYFT_STATION_PROVISIONER=k8s
    export SYFT_STATION_NAMESPACE={{namespace}}
    export SYFT_STATION_SPACE_IMAGE=ghcr.io/openmined/syft-space
    export SYFT_STATION_ADMIN_EMAIL="$admin_email"
    # Spaces run inside k3d; the station is on the host — they reach the
    # credits API through k3d's host alias. The station is off its own domain
    # here, so we can't derive its public URL from the setup domain — override
    # both the internal credits URL and the buyer-facing public URL (minted
    # into spaces as SYFT_CLUSTER_PUBLIC_URL) to that same host alias.
    export SYFT_STATION_CREDITS_URL=http://host.k3d.internal:8090
    export SYFT_STATION_PUBLIC_URL=http://host.k3d.internal:8090
    [ -n "$hub_url" ] && export SYFT_STATION_SYFTHUB_URL="$hub_url"
    # Fixed dev secret so sessions survive reloads/restarts (never used in prod).
    export SYFT_STATION_SESSION_SECRET="dev-not-secret-session-key"
    echo "Station on http://localhost:8090 (backend hot-reloads on .py changes)."
    echo "Frontend: run 'just build-ui' once -> served at :8090/ui (or 'just dev-ui' for HMR)."
    cd backend && uv run syft-station server --reload

# Builds to frontend/dist, which `just dev` serves in place (like syft-space).
# Re-run after frontend changes — uvicorn --reload only watches .py, so it does
# NOT rebuild the frontend. build-only skips vue-tsc (CI's job, and slow
# per-rebuild), like the image build. For live HMR, use `just dev-ui`.

# Build the station frontend so `just dev` serves it at /ui.
build-ui:
    bun run --cwd frontend build-only

# API is proxied to the host backend on :8090. Run in a second terminal.

# Vite dev server for the station frontend (HMR); run alongside `just dev`.
dev-ui:
    cd frontend && bun install && bun dev

# Build the station image (frontend included) and import it into k3d.
station-image:
    docker build -t {{station_image}} .
    k3d image import {{station_image}} -c {{cluster_name}}

# Pass your SyftHub email for the admin role; optionally a different SyftHub:
#   just up you@org.com
#   just up admin=you@org.com hub=https://syfthub.staging.org

# FULL in-cluster: the station pod via Helm (parity with prod).
up admin="" hub="": ensure-cluster station-image
    #!/usr/bin/env bash
    set -euo pipefail
    admin_email="{{admin}}"; admin_email="${admin_email#admin=}"
    hub_url="{{hub}}"; hub_url="${hub_url#hub=}"
    if [ -z "$admin_email" ]; then
        echo "WARNING: no admin email set — every sign-in gets the member role."
        echo "         Use: just up you@org.com"
    fi
    helm_args=(--set-string station.adminEmail="$admin_email")
    if [ -n "$hub_url" ]; then
        helm_args+=(--set-string station.syfthubUrl="$hub_url")
    fi
    # One release, station ON — installs the deps and the station together. The
    # chart preserves the session secret across upgrades, so cookies stay valid.
    helm upgrade --install {{release}} {{chart}} \
        -n {{namespace}} --create-namespace \
        -f {{dev_values}} "${helm_args[@]}" \
        --wait --timeout 300s
    # Force a fresh pod even when the :dev tag is unchanged.
    kubectl -n {{namespace}} rollout restart deploy/{{release}}
    kubectl -n {{namespace}} rollout status deploy/{{release}} --timeout=180s
    echo ""
    echo "Syft Station is up: http://station.localhost"
    echo "First-run setup domain: station.localhost"

# Tear the whole cluster down (station, spaces, and all data).
down:
    k3d cluster delete {{cluster_name}}

# For testing UNPUBLISHED syft-space builds. Normally spaces pull the published
# image (ghcr.io/openmined/syft-space) at whatever tag the admin picks.

# Build a syft-space image from this repo and import it into k3d (dev only).
space-image tag:
    #!/usr/bin/env bash
    set -euo pipefail
    # Accept both `just space-image x` and `just space-image tag=x`.
    tag="{{tag}}"; tag="${tag#tag=}"
    cd ..
    (cd frontend && bun install && bun run build)
    docker build -t ghcr.io/openmined/syft-space:$tag .
    k3d image import ghcr.io/openmined/syft-space:$tag -c {{cluster_name}}

# Render the chart with prod values (sanity check before shipping).
template:
    helm template {{release}} {{chart}} -n {{namespace}}

# Lint the chart (dev + prod values).
lint-chart:
    helm lint {{chart}}
    helm lint {{chart}} -f {{dev_values}}

# Backend tests.
test:
    cd backend && uv run pytest -q

# Lint.
lint:
    cd backend && uv run --extra lint ruff check .

# Format.
format:
    cd backend && uv run --extra lint ruff format .

# Lint + tests, as CI runs them.
check: lint test
